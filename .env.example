# infra/.env — copie para .env e preencha. NAO versionar o .env.

# O IP FIXO da maquina que roda os containers: entra no issuer do realm, nos
# redirect URIs e no catalogo do portal. Precisa ser IP estatico ou reserva de
# DHCP — trocar depois custa recriar o realm e redistribuir o config.json do
# agente Windows em cada maquina. A MESMA linha se repete nos .env dos tres
# projetos; use `python scripts/sync_host_ip.py` para manter os quatro em dia.
HOST_IP=

# --- Postgres do proprio Keycloak (nao e o banco de nenhum dos 3 sistemas) ---
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=

# --- Admin inicial do Keycloak ---
# Usado so no primeiro boot para criar a conta de admin do console. Ela vive no
# realm "master" e NAO entra em nenhum dos tres sistemas, que autenticam no
# realm "ufc" — para isso serve o bloco abaixo.
KC_ADMIN=admin
KC_ADMIN_PASSWORD=

# --- Conta mestra dos tres sistemas ---
# UMA conta, no realm "ufc", administradora do inventario, da despesa e da
# receita ao mesmo tempo. E reconhecida pelos tres backends pelo email exato,
# e so deste endereco: ser admin do console do Keycloak nao da papel nenhum nos
# sistemas, e ela tambem nao depende de grupo — sem essa excecao, tirar a si
# mesmo de um grupo por engano trancaria a porta de quem conserta.
#
# Quem administra o realm pode trocar o email de uma conta e portanto se tornar
# admin dos tres sistemas: mantenha esse circulo pequeno.
# Vazio = sem conta mestra nenhuma.
ADMIN_MESTRE_EMAIL=
ADMIN_MESTRE_SENHA=

# --- Client secrets ---
# Um por aplicacao. Sao clients confidenciais porque no padrao BFF quem troca
# o authorization code por token e sempre um servidor, nunca o navegador.
# Gere com: openssl rand -hex 32
PORTAL_CLIENT_SECRET=
INVENTARIO_CLIENT_SECRET=
RECEITA_CLIENT_SECRET=
DESPESA_CLIENT_SECRET=
CONTROLE_DESPESA_CLIENT_SECRET=

# --- Sessao do portal ---
# Cifra o cookie de sessao (JWE A256GCM). Minimo 32 caracteres; trocar o valor
# invalida todas as sessoes abertas. Gere com: openssl rand -hex 32
PORTAL_SESSION_SECRET=

# --- Portas publicadas de cada aplicacao ---
# Ficam aqui pelo mesmo motivo do HOST_IP: entram nos redirect URIs do realm e
# no catalogo do portal. Se o realm discordar da porta real, o Keycloak recusa
# o redirect_uri com "Invalid parameter".
PORTAL_PORT=3080
INVENTARIO_PORT=3030
RECEITA_PORT=3040
DESPESA_PORT=3010
CONTROLE_DESPESA_PORT=3050
